<div class="dock md:hidden">
  <%= link_to conversations_path, class: request.path.start_with?("/conversations") ? "dock-active" : nil do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path d="<%= ApplicationHelper::ICON_PROPOSTAS %>" />
    </svg>
    <span class="dock-label">Propostas</span>
  <% end %>

  <%= link_to settings_root_path, class: request.path.start_with?("/configuracoes") ? "dock-active" : nil do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path d="<%= ApplicationHelper::ICON_CONFIGURACOES %>" />
    </svg>
    <span class="dock-label">Config</span>
  <% end %>

  <%= link_to users_path, class: current_page?(users_path) ? "dock-active" : nil do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path d="<%= ApplicationHelper::ICON_USUARIOS %>" />
    </svg>
    <span class="dock-label">Usuários</span>
  <% end %>

  <%= button_to session_path, method: :delete,
        form_class: "flex-1 max-w-32 h-full flex flex-col items-center justify-center gap-px cursor-pointer",
        class: "flex flex-col items-center justify-center gap-px w-full h-full bg-transparent border-none p-0 text-inherit" do %>
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
      <path fill-rule="evenodd" d="M3 4.25A2.25 2.25 0 0 1 5.25 2h5.5A2.25 2.25 0 0 1 13 4.25v2a.75.75 0 0 1-1.5 0v-2a.75.75 0 0 0-.75-.75h-5.5a.75.75 0 0 0-.75.75v11.5c0 .414.336.75.75.75h5.5a.75.75 0 0 0 .75-.75v-2a.75.75 0 0 1 1.5 0v2A2.25 2.25 0 0 1 10.75 18h-5.5A2.25 2.25 0 0 1 3 15.75V4.25Z" clip-rule="evenodd" />
      <path fill-rule="evenodd" d="M6 10a.75.75 0 0 1 .75-.75h9.546l-1.048-.943a.75.75 0 1 1 1.004-1.114l2.5 2.25a.75.75 0 0 1 0 1.114l-2.5 2.25a.75.75 0 1 1-1.004-1.114l1.048-.943H6.75A.75.75 0 0 1 6 10Z" clip-rule="evenodd" />
    </svg>
    <span class="dock-label">Sair</span>
  <% end %>
</div>
