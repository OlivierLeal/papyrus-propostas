<h1 class="font-display text-2xl font-bold text-base-content mb-2">Esqueceu sua senha?</h1>
<p class="text-sm text-base-content/60 mb-6">Informe seu e-mail e enviaremos instruções para redefinir sua senha.</p>

<% if alert = flash[:alert] %>
  <div class="alert alert-error alert-soft mb-4"><%= alert %></div>
<% end %>

<%= form_with url: passwords_path, class: "flex flex-col gap-4" do |form| %>
  <label class="form-control">
    <div class="label"><span class="label-text">E-mail</span></div>
    <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username",
          placeholder: "seuemail@papyrus.com", value: params[:email_address], class: "input input-bordered w-full" %>
  </label>

  <%= form.submit "Enviar instruções", class: "btn btn-primary w-full mt-2" %>

  <div class="text-center text-sm">
    <%= link_to "Voltar para o login", new_session_path, class: "link link-primary" %>
  </div>
<% end %>
