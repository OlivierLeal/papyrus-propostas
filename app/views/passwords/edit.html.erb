<h1 class="font-display text-2xl font-bold text-base-content mb-6">Redefinir senha</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "flex flex-col gap-4" do |form| %>
  <label class="form-control">
    <div class="label"><span class="label-text">Nova senha</span></div>
    <%= form.password_field :password, required: true, autocomplete: "new-password",
          placeholder: "Digite a nova senha", maxlength: 72, class: "input input-bordered w-full" %>
  </label>

  <label class="form-control">
    <div class="label"><span class="label-text">Confirme a nova senha</span></div>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password",
          placeholder: "Repita a nova senha", maxlength: 72, class: "input input-bordered w-full" %>
  </label>

  <%= form.submit "Salvar", class: "btn btn-primary w-full mt-2" %>
<% end %>
