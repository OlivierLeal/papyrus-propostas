<%# Card de um documento que a IA propôs guardar no acervo RAG como "voz da Papyrus" (ver
    LearnFromRevisedProposalTool). Enquanto pendente, ele NÃO é consultável — só entra no
    índice/embedding quando o consultor aprova aqui (HistoricalProposal#approve!). %>
<div id="<%= dom_id(historical_proposal) %>" class="flex flex-col gap-3">
  <div class="flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 mt-0.5 opacity-70">
      <path fill-rule="evenodd" d="M4 4a2 2 0 0 1 2-2h4.586A2 2 0 0 1 12 2.586L15.414 6A2 2 0 0 1 16 7.414V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Z" clip-rule="evenodd" />
    </svg>
    <div class="flex flex-col gap-1 min-w-0">
      <span class="text-xs uppercase tracking-wide opacity-70">Versão final para o acervo</span>
      <p class="text-sm font-medium truncate"><%= historical_proposal.filename %></p>
      <% if historical_proposal.pending_text.present? %>
        <p class="text-xs opacity-60 line-clamp-3"><%= truncate(historical_proposal.pending_text, length: 300) %></p>
      <% end %>
    </div>
  </div>

  <% if historical_proposal.pending? %>
    <div class="flex items-center gap-2">
      <%= button_to "Guardar no acervo",
            approve_conversation_historical_proposal_path(historical_proposal.conversation, historical_proposal),
            class: "btn btn-xs btn-primary" %>
      <%= button_to "Descartar",
            reject_conversation_historical_proposal_path(historical_proposal.conversation, historical_proposal),
            class: "btn btn-xs btn-ghost" %>
    </div>
  <% elsif historical_proposal.approved? %>
    <p class="text-xs text-success flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
      Guardado — vai servir de referência de escrita em propostas futuras
    </p>
  <% else %>
    <p class="text-xs opacity-60">Descartado.</p>
  <% end %>
</div>
