<%# Card de uma pendência (ProjectIssue): trava a geração até responder ou liberar com motivo. %>
<div id="<%= dom_id(issue) %>" class="flex flex-col gap-3">
  <div class="flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 mt-0.5 <%= issue.open? ? "text-warning" : "text-success" %>">
      <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0ZM8.94 6.94a.75.75 0 1 1-.02 1.06.75.75 0 0 1 .02-1.06ZM10 9a.75.75 0 0 0-.75.75v4.5a.75.75 0 0 0 1.5 0v-4.5A.75.75 0 0 0 10 9Z" clip-rule="evenodd" />
    </svg>
    <div class="flex flex-col gap-1 min-w-0">
      <span class="text-xs uppercase tracking-wide opacity-70">
        Pendência<%= " · trava a geração da proposta" if issue.open? %>
      </span>
      <p class="text-sm font-semibold"><%= issue.question %></p>
      <% if issue.impact.present? %>
        <p class="text-xs opacity-70">Impacto: <%= issue.impact %></p>
      <% end %>
    </div>
  </div>

  <% if issue.open? %>
    <%= form_with url: answer_conversation_project_issue_path(issue.conversation, issue), method: :post, class: "flex flex-col gap-2" do |form| %>
      <%= form.text_area :answer, rows: 2, required: true, placeholder: "Resposta",
            class: "textarea textarea-bordered textarea-sm w-full" %>
      <%= form.submit "Responder", class: "btn btn-xs btn-primary self-start" %>
    <% end %>
    <details>
      <summary class="text-xs opacity-70 cursor-pointer">Seguir sem resposta</summary>
      <%= form_with url: waive_conversation_project_issue_path(issue.conversation, issue), method: :post, class: "flex flex-col gap-2 mt-2" do |form| %>
        <%= form.text_field :reason, required: true, placeholder: "Por que seguir sem resposta? (vira ressalva na proposta)",
              class: "input input-bordered input-xs w-full" %>
        <%= form.submit "Seguir sem resposta", class: "btn btn-xs btn-ghost self-start" %>
      <% end %>
    </details>
  <% elsif issue.answered? %>
    <p class="text-xs text-success">
      Respondido por <%= issue.resolved_by&.name || "consultor" %>: <%= issue.answer %>
    </p>
  <% else %>
    <p class="text-xs opacity-70">
      Liberado sem resposta por <%= issue.resolved_by&.name || "consultor" %> — <%= issue.waiver_reason %> (sai como ressalva).
    </p>
  <% end %>
</div>
