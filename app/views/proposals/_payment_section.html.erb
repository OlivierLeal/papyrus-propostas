<%# Desembolso (parcelas editáveis) + formato do documento final. locals: form, pricing, proposal, editable %>
<section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <div class="flex flex-col gap-px bg-base-300 rounded-box overflow-hidden">
    <%# Parcelas editáveis (2026-09-27): marco, % e data; valor calculado a partir do total. Linha
        sem marco é descartada no servidor (ProjectPricing#payment_schedule_items=). %>

    <div class="bg-base-100 p-6" data-controller="payment-schedule" data-payment-schedule-total-value="<%= pricing.total_value.to_f %>"
         data-action="pricing-preview:total@window->payment-schedule#updateTotal">
      <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
          <h2 class="font-semibold text-base-content">Desembolso</h2>
          <p class="text-sm text-base-content/60 mt-0.5">Valor de cada parcela = % × total da proposta. A data é opcional e não vai para o documento.</p>
        </div>
        <span class="text-sm text-base-content/60">Soma: <strong data-payment-schedule-target="sum" class="tabular-nums"><%= pricing.payment_percentage_total.to_s("F").sub(/\.0\z/, "") %>%</strong></span>
      </div>

      <div role="alert" class="alert alert-error alert-soft text-sm mt-3 py-2" data-payment-schedule-target="warning" hidden>
        <span>Os percentuais precisam somar 100% para salvar.</span>
      </div>

      <div class="overflow-x-auto mt-3">
        <table class="table table-sm">
          <thead>
            <tr class="text-xs uppercase tracking-wide text-base-content/50">
              <th class="font-semibold">Marco</th>
              <th class="font-semibold">%</th>
              <th class="font-semibold text-right">Valor</th>
              <th class="font-semibold">Data</th>
              <th></th>
            </tr>
          </thead>
          <tbody data-payment-schedule-target="body">
            <% pricing.payment_schedule_amounts.each_with_index do |item, index| %>
              <%= render "payment_row", index: index, item: item, amount: item["amount"], editable: editable %>
            <% end %>
          </tbody>
        </table>
      </div>

      <% if editable %>
        <template data-payment-schedule-target="template">
          <%= render "payment_row", index: "NEW_INDEX", item: { "label" => "", "percentage" => 0 }, amount: 0, editable: editable %>
        </template>
        <button type="button" class="btn btn-ghost btn-sm text-primary mt-2" data-action="payment-schedule#add">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" /></svg>
          Adicionar parcela
        </button>
      <% end %>
    </div>

    <%# Quadro de Preço do documento (2026-09-28): total, por item, ou por item + empreendimento.
        Valores de ProjectPricing#price_rows/#enterprise_totals, sempre calculados em Ruby. %>
    <div class="bg-base-100 p-6">
      <h2 class="font-semibold text-base-content">Quadro de preço no documento</h2>
      <p class="text-sm text-base-content/60 mt-0.5 mb-4">Quando o cliente pede o valor de cada etapa/estudo ou de cada empreendimento.</p>
      <div class="grid sm:grid-cols-3 gap-3">
        <% ProjectPricing::PRICE_PRESENTATIONS.each do |value, label| %>
          <label class="flex items-start gap-3 p-3 rounded-box border border-base-300 cursor-pointer transition-colors hover:border-primary/40 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 <%= "opacity-60 pointer-events-none" unless editable %>">
            <%= form.radio_button :price_presentation, value, disabled: !editable, class: "radio radio-primary radio-sm mt-0.5" %>
            <span class="text-sm font-medium text-base-content"><%= label %></span>
          </label>
        <% end %>
      </div>
      <% mode = proposal.price_presentation_mode %>
      <% if pricing.price_presentation != "total" && mode != pricing.price_presentation %>
        <div role="alert" class="alert alert-warning alert-soft text-sm mt-4 py-2">
          <span>
            <% if mode == "total" %>
              A proposta tem um item só — o documento sai com o preço total. Divida o serviço em itens acima.
            <% else %>
              Menos de 2 empreendimentos cadastrados — o documento sai aberto só por item.
            <% end %>
          </span>
        </div>
      <% end %>
      <% if mode != "total" %>
        <ul class="mt-4 flex flex-col gap-1.5 text-sm max-w-xl">
          <% pricing.price_rows.each do |label, value| %>
            <li class="flex justify-between gap-3"><span class="text-base-content/70 min-w-0 truncate"><%= label %></span><span class="tabular-nums shrink-0"><%= brl(value) %></span></li>
          <% end %>
          <% if mode == "empreendimentos" %>
            <% pricing.enterprise_totals.each do |name, value| %>
              <li class="flex justify-between gap-3 font-medium"><span>Total – <%= name %></span><span class="tabular-nums"><%= brl(value) %></span></li>
            <% end %>
          <% end %>
          <li class="flex justify-between gap-3 border-t border-base-300 pt-1.5 font-semibold">
            <span>Total</span><span class="tabular-nums"><%= brl(pricing.total_value) %></span>
          </li>
        </ul>
        <p class="text-xs text-base-content/50 mt-2">Valores do último "Salvar e recalcular".</p>
      <% end %>
    </div>

    <div class="bg-base-100 p-6">
      <h2 class="font-semibold text-base-content">Formato do documento</h2>
      <p class="text-sm text-base-content/60 mt-0.5 mb-4">Licitações costumam exigir envelopes separados.</p>

      <div class="grid sm:grid-cols-2 gap-3">
        <% [ [ "combined", "Documento único", "Técnica e comercial no mesmo arquivo (PTC)." ],
             [ "separated", "Técnica e comercial separadas", "Dois arquivos (PT + PC)." ] ].each do |value, label, hint| %>
          <label class="flex items-start gap-3 p-3 rounded-box border border-base-300 cursor-pointer transition-colors hover:border-primary/40 has-[:checked]:border-primary/50 has-[:checked]:bg-primary/5 <%= "opacity-60 pointer-events-none" unless editable %>">
            <%= radio_button_tag "proposal[document_split]", value, proposal.document_split == value, disabled: !editable, class: "radio radio-primary radio-sm mt-0.5" %>
            <span>
              <span class="block text-sm font-medium text-base-content"><%= label %></span>
              <span class="block text-xs text-base-content/60"><%= hint %></span>
            </span>
          </label>
        <% end %>
      </div>
    </div>
  </div>
</section>
