<%
  pricing = @proposal.project_pricing
  editable = @proposal.status != "approved"
  status_label, status_class = {
    "draft" => [ "Rascunho", "badge-warning" ],
    "priced" => [ "Precificado", "badge-info" ],
    "approved" => [ "Aprovado", "badge-success" ]
  }.fetch(@proposal.status, [ @proposal.status, "badge-ghost" ])
%>

<div class="p-4 lg:p-8">
  <div class="flex flex-wrap items-start gap-3 mb-6">
    <%= link_to conversation_path(@conversation), class: "btn btn-ghost btn-sm btn-square mt-1", title: "Voltar para a conversa" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="font-display text-2xl font-bold text-base-content leading-tight">Precificação</h1>
        <span class="badge badge-soft <%= status_class %>"><%= status_label %></span>
      </div>
      <p class="text-sm text-base-content/60 mt-0.5">
        <span class="font-mono"><%= @proposal.docx_numero_proposta %></span> ·
        <%= @conversation.client_name %> · <%= @conversation.study_types_label %>
      </p>
    </div>
  </div>

  <%# Formulários "satélite" (adicionar membro, item de cronograma, recalcular logística) ficam
      FORA do form principal e vazios — os campos deles, desenhados dentro dos cards, se ligam a
      eles pelo atributo HTML `form=`. Form dentro de form é HTML inválido: o navegador ignorava o
      <form> interno e fechava o externo no primeiro </form>, e os campos iam pro formulário
      errado (relato do consultor, 2026-09: "seleciono a pessoa e não consigo adicionar"). %>
  <% if editable %>
    <%= tag.form(id: "add-member-form", action: conversation_proposal_proposal_professionals_path(@conversation), method: "post", class: "hidden") { token_tag } %>
    <%= tag.form(id: "suggest-logistics-form", action: suggest_logistics_conversation_proposal_path(@conversation), method: "post", class: "hidden") { token_tag } %>
    <% ScheduleItem::SCHEDULE_TYPE_LABELS.each_key do |schedule_type| %>
      <%= tag.form(id: "add-schedule-#{schedule_type}", action: conversation_proposal_schedule_items_path(@conversation), method: "post", class: "hidden") { token_tag } %>
    <% end %>
  <% end %>

  <div class="grid xl:grid-cols-[minmax(0,1fr)_22rem] gap-6 items-start">
    <div class="flex flex-col gap-6 min-w-0">
      <%= form_with model: pricing, url: conversation_proposal_path(@conversation), method: :patch, id: "pricing-form", class: "flex flex-col gap-6" do |form| %>
        <%= render "team_section", form: form, pricing: pricing, editable: editable, conversation: @conversation, professionals: @professionals %>
        <%= render "parameters_section", form: form, pricing: pricing, editable: editable %>
        <%= render "payment_section", form: form, pricing: pricing, proposal: @proposal, editable: editable %>

        <section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
          <div class="px-6 pt-5">
            <h2 class="font-semibold text-base-content">Cronograma</h2>
            <p class="text-sm text-base-content/60 mt-0.5">
              Sugerido pela IA a partir do ET/TR — ajuste aqui se precisar. Sem itens (ou sem data de início), a página não sai no documento.
            </p>
          </div>
          <%= render "schedule_section", form: form, pricing: pricing, conversation: @conversation, schedule_type: "servico", editable: editable %>
          <%= render "schedule_section", form: form, pricing: pricing, conversation: @conversation, schedule_type: "implantacao", editable: editable %>
        </section>
      <% end %>

      <%= render "external_costs_section", title: "Custos externos",
            description: "ARTs, taxas, locações, passagens e outros custos repassados.",
            empty_message: "Nenhum custo externo lançado.",
            costs: pricing.other_external_costs, kind: nil, conversation: @conversation, editable: editable %>

      <%# Serviços Terceirizados (2026-09): 100% manual — a IA nunca marca nada como terceirizado,
          e o texto da proposta nunca revela isso ao cliente (ver GenerateProposalDocumentTool). %>
      <%= render "external_costs_section", title: "Serviços terceirizados",
            description: "Uso interno — nunca aparece como terceirizado no documento do cliente.",
            empty_message: "Nenhum serviço terceirizado lançado.",
            costs: pricing.outsourced_costs, kind: "terceirizado", conversation: @conversation, editable: editable %>
    </div>

    <aside class="flex flex-col gap-6 xl:sticky xl:top-6">
      <%= render "summary", pricing: pricing, proposal: @proposal, conversation: @conversation, editable: editable %>
      <%= render "generated_documents", proposal: @proposal %>
    </aside>
  </div>
</div>
