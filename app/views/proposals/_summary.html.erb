<%# Composição do preço, na lateral. Fica FORA do form principal; BDI e impostos são editados
    aqui mesmo (2026-10, remodelagem — é onde eles mudam o preço) e se ligam ao #pricing-form pelo
    atributo `form=`. Total e ações ficam na barra do topo (proposals/_action_bar).
    locals: pricing, editable %>
<%# Composição (2026-09-30, pedido do cliente: "deixar o valor puro e aplicar embaixo — alguns clientes
    querem saber HH, logística, BDI e impostos separados"): as partes aparecem SEM margem, e BDI e
    impostos entram como linhas próprias. A conta não mudou (ProjectPricing#price_composition fecha
    centavo a centavo com total_value); só a forma de mostrar. %>
<% c = pricing.price_composition %>
<section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <dl class="px-5 py-4 flex flex-col gap-2 text-sm">
    <dt class="text-xs uppercase tracking-wide text-base-content/50 font-semibold">Composição do preço</dt>
    <%= render "proposals/composition_row", label: "Equipe", value: c[:team], target: "summaryTeam" %>
    <%= render "proposals/composition_row", label: "Logística dos campos", value: c[:logistics], target: "summaryLogistics" %>
    <%= render "proposals/composition_row", label: "Custos dos itens", value: c[:item_costs], target: "summaryItemCosts" %>
    <%# Desde 2026-10-16 externos e terceirizados são custo direto e levam BDI e impostos (Charlene). %>
    <% if c[:external].positive? %>
      <%= render "proposals/composition_row", label: "Custos externos", value: c[:external] %>
    <% end %>
    <% if c[:outsourced].positive? %>
      <%= render "proposals/composition_row", label: "Terceirizados", value: c[:outsourced] %>
    <% end %>
    <%= render "proposals/composition_row", label: "Custo direto", value: c[:direct], target: "summaryDirect", strong: true %>

    <% [ [ :bdi, "+ BDI", c[:bdi], "summaryBdi" ], [ :tax_multiplier, "+ Impostos/ADM", c[:taxes], "summaryTaxes" ] ].each do |attribute, label, value, target| %>
      <div class="flex items-center justify-between gap-2">
        <dt class="text-base-content/70 whitespace-nowrap"><%= label %></dt>
        <label class="input input-xs w-[4.5rem] shrink-0 <%= 'input-disabled' unless editable %>" title="Multiplicador (1,30 = +30%)">
          <%= number_field_tag "project_pricing[#{attribute}]", decimal_input(pricing.public_send(attribute)), id: "pricing_#{attribute}", form: "pricing-form",
                step: "any", min: 0, disabled: !editable, autocomplete: "off", class: "grow text-right tabular-nums", aria: { label: label.delete_prefix("+ ") } %>
          <span class="text-base-content/40">×</span>
        </label>
        <dd class="ml-auto tabular-nums text-base-content whitespace-nowrap" data-pricing-preview-target="<%= target %>"><%= brl(value) %></dd>
      </div>
    <% end %>

    <div class="border-t-2 border-base-content/70 pt-2 mt-1 flex justify-between gap-3 font-display font-bold text-base text-base-content">
      <dt>Total</dt>
      <dd class="tabular-nums" data-pricing-preview-target="compositionTotal"><%= brl(pricing.total_value) %></dd>
    </div>
    <%= link_to budget_spreadsheet_conversation_proposal_path(pricing.proposal.conversation), class: "btn btn-ghost btn-xs mt-1 self-start", data: { turbo: false },
          title: "Planilha .xlsx com HH, diárias, logística, BDI e impostos em fórmulas (o preço salvo; salve antes se mudou algo)" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4"><path d="M10.75 2.75a.75.75 0 0 0-1.5 0v8.614L6.295 8.235a.75.75 0 1 0-1.09 1.03l4.25 4.5a.75.75 0 0 0 1.09 0l4.25-4.5a.75.75 0 0 0-1.09-1.03l-2.955 3.129V2.75Z" /><path d="M3.5 12.75a.75.75 0 0 0-1.5 0v2.5A2.75 2.75 0 0 0 4.75 18h10.5A2.75 2.75 0 0 0 18 15.25v-2.5a.75.75 0 0 0-1.5 0v2.5c0 .69-.56 1.25-1.25 1.25H4.75c-.69 0-1.25-.56-1.25-1.25v-2.5Z" /></svg>
      Baixar planilha orçamentária
    <% end %>
  </dl>
</section>
