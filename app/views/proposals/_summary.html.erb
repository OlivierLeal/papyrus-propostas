<%# Resumo lateral + ações. Fica FORA do form principal: "Salvar e recalcular" se liga a ele pelo
    atributo `form=`, e "Aprovar preço" (button_to) tem o próprio form. locals: pricing, proposal,
    conversation, editable %>
<section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <div class="px-6 pt-5 pb-4">
    <div class="flex items-center justify-between gap-2">
      <p class="text-xs uppercase tracking-wide text-base-content/50 font-semibold">Total da proposta</p>
      <span class="badge badge-warning badge-soft badge-sm" data-pricing-preview-target="dirty" hidden title="Os valores mudam na hora enquanto você edita; clique em Salvar e recalcular para gravar">Prévia · não salvo</span>
    </div>
    <p class="font-display text-3xl font-bold text-primary tabular-nums mt-1" data-pricing-preview-target="summaryTotal"><%= brl(pricing.total_value) %></p>
  </div>

  <dl class="border-t border-base-300 px-6 py-4 flex flex-col gap-2 text-sm">
    <% outsourced = pricing.outsourced_costs.sum { |cost, _| cost["value"].to_f } %>
    <% [ [ "Equipe", pricing.professionals_total, "summaryTeam" ],
         [ "Logística", pricing.logistics_total, "summaryLogistics" ],
         [ "Custos externos", pricing.external_costs_total - outsourced, nil ],
         [ "Terceirizados", outsourced, nil ] ].each do |label, value, target| %>
      <div class="flex justify-between gap-3">
        <dt class="text-base-content/60"><%= label %></dt>
        <dd class="text-base-content tabular-nums" <% if target %>data-pricing-preview-target="<%= target %>"<% end %>><%= brl(value) %></dd>
      </div>
    <% end %>
  </dl>

  <div class="border-t border-base-300 px-6 py-4">
    <p class="text-xs uppercase tracking-wide text-base-content/50 font-semibold mb-2">Desembolso</p>
    <ul class="flex flex-col gap-1.5 text-sm">
      <% pricing.payment_schedule_amounts.each do |item| %>
        <li class="flex justify-between gap-3">
          <span class="text-base-content/60 min-w-0 truncate">
            <%= item["label"] %> · <%= item["percentage"] %>%<%= " · #{Date.parse(item["date"]).strftime("%d/%m/%Y")}" if item["date"].present? %>
          </span>
          <span class="text-base-content tabular-nums shrink-0" data-pricing-preview-target="installment" data-percentage="<%= item["percentage"] %>"><%= brl(item["amount"]) %></span>
        </li>
      <% end %>
    </ul>
  </div>

  <div class="border-t border-base-300 px-6 py-4 flex flex-col gap-2">
    <% if editable %>
      <button type="submit" form="pricing-form" class="btn btn-primary w-full">Salvar e recalcular</button>
      <%= button_to "Aprovar preço", approve_conversation_proposal_path(conversation), method: :post,
            class: "btn btn-success btn-outline w-full",
            form: { data: { turbo_confirm: "Aprovar o preço de #{brl(pricing.total_value)}? Isso trava a precificação e conclui a proposta." } } %>
      <p class="text-xs text-base-content/50 text-center">Salve antes de aprovar — alterações não salvas não entram.</p>
    <% else %>
      <div class="alert alert-success alert-soft text-sm">
        <span>
          Preço aprovado<%= " em #{l(proposal.approved_at, format: '%d/%m/%Y')}" if proposal.approved_at %>. Proposta concluída.
        </span>
      </div>
      <%# Reabrir (2026-09-27): o cliente às vezes pede mudança depois da aprovação. %>
      <details class="group">
        <summary class="btn btn-ghost btn-sm w-full list-none">Reabrir para ajuste</summary>
        <%= form_with url: reopen_conversation_proposal_path(conversation), method: :post, class: "flex flex-col gap-2 mt-2" do |reopen_form| %>
          <%= reopen_form.text_area :reason, rows: 2, class: "textarea textarea-sm w-full",
                placeholder: "Motivo (opcional) — ex.: cliente pediu incluir campanha de fauna" %>
          <%= reopen_form.submit "Reabrir precificação", class: "btn btn-warning btn-sm w-full",
                data: { turbo_confirm: "Reabrir a precificação aprovada de #{brl(pricing.total_value)}? A proposta volta a ser editável e precisa ser aprovada de novo." } %>
          <p class="text-xs text-base-content/50">O preço aprovado fica registrado. Documentos já gerados não mudam; a próxima geração sai como nova revisão.</p>
        <% end %>
      </details>
    <% end %>
  </div>
</section>
