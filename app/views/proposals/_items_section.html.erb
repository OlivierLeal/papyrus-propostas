<%# Itens, campos de logística e empreendimentos (2026-09-28, modelo da planilha real da Papyrus).
    Tudo dentro do #pricing-form; adicionar/remover são botões name="structure_action" (ver
    PricingStructure) — salvam o que foi digitado antes, sem form aninhado.
    locals: form, pricing, editable %>
<% items = pricing.pricing_items.includes({ field_campaigns: :ibge_municipality }, proposal_professionals: :professional).to_a %>
<% enterprises = pricing.pricing_enterprises.to_a %>
<%# Com poucos campos eles já abrem; com muitos, ficam na linha de resumo e abrem sob demanda. %>
<% open_campaigns = items.sum { |item| item.field_campaigns.length } <= 3 %>
<% enterprise_options = [ [ "Comum a todos", "" ] ] + enterprises.map { |enterprise| [ enterprise.name, enterprise.id ] } %>

<section id="itens" class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3 px-6 pt-5 pb-4">
    <div>
      <h2 class="font-semibold text-base-content">Itens e idas a campo</h2>
      <p class="text-sm text-base-content/60 mt-0.5">
        Cada item soma a equipe dele, os campos (idas a campo) e os custos fechados. Valores puros; BDI e impostos entram no resumo ao lado.
      </p>
      <p class="text-sm mt-1">
        <span class="text-base-content/60">Logística dos campos:</span>
        <strong class="tabular-nums" data-pricing-preview-target="logistics"><%= brl(items.sum(&:campaigns_cost).round(2)) %></strong>
      </p>
    </div>
    <% if editable %>
      <div class="flex flex-wrap gap-2">
        <% if SpreadsheetFill.client_spreadsheets(pricing.proposal.conversation).any? %>
          <button type="submit" form="rebuild-from-sheet-form" class="btn btn-ghost btn-sm text-primary"
                  title="Cria um item para cada item da lista de preços do cliente (PPU), com as quantidades dele, e dimensiona a equipe por unidade">
            Reorganizar pela planilha do cliente
          </button>
        <% end %>
        <%= structure_button("+ Item", "add_item", editable: editable, css: "btn btn-outline btn-primary btn-sm") %>
      </div>
    <% end %>
  </div>

  <% unpriced = items.flat_map { |item| item.costs.select { |cost| cost["unit_value"].to_d.zero? && cost["quantity"].to_d.positive? } } %>
  <% if unpriced.any? %>
    <div class="mx-6 mb-4 alert alert-warning alert-soft text-xs py-2">
      <span>
        <strong><%= unpriced.size == 1 ? "1 custo está" : "#{unpriced.size} custos estão" %> sem valor unitário</strong>
        (<%= unpriced.map { |cost| cost["description"] }.first(6).to_sentence %><%= "…" if unpriced.size > 6 %>) — a IA lista a quantidade, o valor em R$ é da Papyrus. Enquanto estiver zerado, não entra no preço.
      </span>
    </div>
  <% end %>

  <% pending = items.flat_map(&:field_campaigns).select(&:lodging_pending?) %>
  <% if pending.any? %>
    <div class="mx-6 mb-4 alert alert-warning alert-soft text-xs py-2">
      <span>
        <%= pending.size == 1 ? "1 campo com pernoite está" : "#{pending.size} campos com pernoite estão" %> sem hospedagem escolhida
        (<%= pending.map(&:description).to_sentence %>) — usando o valor padrão de <%= brl(pricing.lodging_per_person_per_night) %>/noite.
        Busque e escolha a hospedagem, informe um alojamento ou marque como fornecida pelo cliente.
      </span>
    </div>
  <% end %>

  <div class="flex flex-col divide-y divide-base-300 border-t border-base-300">
    <%= form.fields_for :pricing_items, items do |item_form| %>
      <% item = item_form.object %>
      <div id="item-<%= item.id %>" class="px-6 py-5" data-pricing-preview-target="item" data-item-id="<%= item.id %>">
        <%= item_form.hidden_field :id %>
        <div class="flex flex-wrap items-end gap-3">
          <fieldset class="fieldset p-0 grow min-w-60">
            <legend class="fieldset-legend pt-0 flex items-center gap-2">
              Item
              <% if item.mirrored? %>
                <span class="badge badge-soft badge-primary badge-xs" title="Espelha a lista de preços do cliente (<%= item.client_sheet["aba"] %>!<%= item.client_sheet["celula_preco"] %>)">Planilha do cliente · <%= item.client_label %></span>
              <% end %>
            </legend>
            <%= item_form.text_field :name, disabled: !editable, required: true, class: "input input-sm w-full font-medium" %>
          </fieldset>
          <% if item.mirrored? %>
            <fieldset class="fieldset p-0">
              <legend class="fieldset-legend pt-0">Quantidade do cliente</legend>
              <label class="input input-sm w-44">
                <%= item_form.number_field :client_quantity, step: "any", min: 0, disabled: !editable, autocomplete: "off", class: "grow text-right tabular-nums",
                      data: { role: "client-quantity" } %>
                <span class="text-xs text-base-content/50 truncate max-w-20" title="<%= item.client_unit %>"><%= item.client_unit %></span>
              </label>
            </fieldset>
          <% end %>
          <% if enterprises.any? %>
            <fieldset class="fieldset p-0">
              <legend class="fieldset-legend pt-0">Empreendimento</legend>
              <%= item_form.select :pricing_enterprise_id, enterprise_options, {}, disabled: !editable, class: "select select-sm w-52" %>
            </fieldset>
          <% end %>
          <div class="text-right ml-auto">
            <p class="text-xs text-base-content/50">
              Equipe <span data-role="item-team"><%= brl(item.team_cost.round(2)) %></span> ·
              Campos <span data-role="item-campaigns"><%= brl(item.campaigns_cost.round(2)) %></span> ·
              Custos <span data-role="item-costs"><%= brl(item.costs_cost.round(2)) %></span>
            </p>
            <p class="font-semibold tabular-nums text-base-content" data-role="item-total"><%= brl(item.direct_total.round(2)) %></p>
            <% if item.mirrored? %>
              <p class="text-xs text-base-content/50" title="Custo puro do item ÷ quantidade do cliente, antes de BDI, impostos e do rateio dos itens comuns">
                <%= brl((item.direct_total / item.client_quantity).round(2)) %> por <%= item.client_unit.presence || "unidade" %> (custo)
              </p>
            <% end %>
          </div>
          <% if editable && items.size > 1 %>
            <%= structure_button("Remover item", "remove_item:#{item.id}", editable: editable, css: "btn btn-ghost btn-xs text-error",
                  confirm: "Remover o item #{item.name}? A equipe dele vai pro primeiro item; campos e custos saem.") %>
          <% end %>
        </div>
        <p class="text-xs text-base-content/50 mt-2">
          Equipe: <%= item.proposal_professionals.map { |line| line.professional.name }.uniq.to_sentence.presence || "ninguém ainda — escolha o item na tabela Equipe" %>.
        </p>

        <%# Campos %>
        <div class="mt-4">
          <div class="flex items-center justify-between gap-2">
            <h4 class="text-xs uppercase tracking-wide font-semibold text-base-content/50">Campos</h4>
            <% if editable %><%= structure_button("+ Campo", "add_campaign:#{item.id}", editable: editable) %><% end %>
          </div>
          <% if item.field_campaigns.any? %>
            <div class="flex flex-col gap-2 mt-2">
              <%= item_form.fields_for :field_campaigns, item.field_campaigns do |campaign_form| %>
                <% campaign = campaign_form.object %>
                <%# Campo recolhido numa linha de resumo (2026-10, remodelagem): abre pra editar. Os campos
                    dentro do <details> fechado continuam indo no envio do formulário. %>
                <details id="campo-<%= campaign.id %>" class="group/campo rounded-box border border-base-300 scroll-mt-40" data-pricing-preview-target="campaign"
                         data-item-id="<%= item.id %>" data-distance-km="<%= campaign.distance_km&.to_f %>" <% if open_campaigns %>open<% end %>>
                  <summary class="flex items-center gap-3 px-3 py-2.5 cursor-pointer list-none rounded-box hover:bg-base-200/40">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 text-base-content/40 -rotate-90 group-open/campo:rotate-0 transition-transform"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
                    <span class="min-w-0 flex-1">
                      <span class="block text-sm font-medium text-base-content truncate"><%= campaign.description %></span>
                      <span class="block text-xs text-base-content/60 tabular-nums">
                        <%= pluralize(campaign.people, "pessoa", plural: "pessoas") %> ·
                        <%= decimal_label(campaign.days) %> <%= campaign.days == 1 ? "dia" : "dias" %><%= " + #{decimal_label(campaign.travel_days)} de viagem" if campaign.travel_days.positive? %> ·
                        <%= campaign.vehicles %> <%= FieldCampaign::VEHICLE_TYPES[campaign.vehicle_type] %>
                      </span>
                    </span>
                    <% if campaign.lodging_pending? %>
                      <span class="badge badge-warning badge-soft badge-sm whitespace-nowrap">hospedagem a definir</span>
                    <% elsif campaign.lodging_mode %>
                      <span class="badge badge-ghost badge-sm whitespace-nowrap max-w-40 truncate" title="<%= campaign.lodging_name %>"><%= campaign.lodging_mode == "cliente" ? "hospedagem do cliente" : campaign.lodging_name.presence || FieldCampaign::LODGING_MODES[campaign.lodging_mode] %></span>
                    <% end %>
                    <span class="text-sm font-semibold tabular-nums whitespace-nowrap" data-role="campaign-total"><%= brl(campaign.cost(pricing).round(2)) %></span>
                  </summary>
                  <div class="px-3 pb-3 pt-1 border-t border-base-300">
                  <%= campaign_form.hidden_field :id %>
                  <div class="flex items-center gap-2 mt-2">
                    <%= campaign_form.text_field :description, disabled: !editable, required: true, class: "input input-sm grow", aria: { label: "Descrição do campo" } %>
                    <% if editable %>
                      <%= structure_button("Remover campo", "remove_campaign:#{campaign.id}", editable: editable, css: "btn btn-ghost btn-xs text-error",
                            confirm: "Remover o campo #{campaign.description}?") %>
                    <% end %>
                  </div>
                  <div class="flex flex-wrap gap-x-3 gap-y-2 mt-2">
                    <% [ [ :people, "Pessoas", 1 ], [ :days, "Dias em campo", "any" ], [ :travel_days, "Dias de viagem", "any" ], [ :vehicles, "Veículos", 1 ] ].each do |attribute, label, step| %>
                      <label class="flex flex-col text-[11px] text-base-content/60">
                        <%= label %>
                        <%= campaign_form.number_field attribute, step: step, min: 0, disabled: !editable, autocomplete: "off", class: "input input-xs w-20 text-right", data: { field: attribute } %>
                      </label>
                    <% end %>
                    <label class="flex flex-col text-[11px] text-base-content/60">
                      Veículo
                      <%= campaign_form.select :vehicle_type, FieldCampaign::VEHICLE_TYPES.invert, {}, disabled: !editable, class: "select select-xs w-20", data: { field: "vehicle_type" } %>
                    </label>
                    <% [ [ :tolls, "Pedágios", 1 ], [ :washes, "Lavagens", 1 ], [ :uber_trips, "Uber", 1 ], [ :mateiro_days, "Mateiro (dias)", "any" ], [ :epi_count, "EPI/ASO", 1 ] ].each do |attribute, label, step| %>
                      <label class="flex flex-col text-[11px] text-base-content/60">
                        <%= label %>
                        <%= campaign_form.number_field attribute, step: step, min: 0, disabled: !editable, autocomplete: "off", class: "input input-xs w-20 text-right", data: { field: attribute } %>
                      </label>
                    <% end %>
                  </div>
                  <%= render "campaign_lodging", campaign_form: campaign_form, campaign: campaign, pricing: pricing, editable: editable %>
                  </div>
                </details>
              <% end %>
            </div>
            <p class="text-[11px] text-base-content/50 mt-1">
              Custo = veículos × (dias em campo + viagem) × diária do veículo + combustível (distância da sede ida e volta + <%= number_with_delimiter(pricing.daily_km.to_f, delimiter: ".", separator: ",") %> km/dia em campo + ida e volta diária até a hospedagem)
              + alimentação por pessoa-dia + hospedagem por pessoa-noite + extras (valor puro).
              Deslocamento acima de <%= hours_label(FieldCampaign::COMMUTE_TOLERANCE_HOURS) %> por trecho tira horas da jornada de <%= FieldCampaign::WORKDAY_HOURS %>h e alonga os dias em campo (e as diárias da equipe do item).
            </p>
          <% else %>
            <p class="text-xs text-base-content/50 mt-1">Sem ida a campo.</p>
          <% end %>
        </div>

        <%# Custos fechados do item %>
        <div class="mt-4">
          <div class="flex items-center justify-between gap-2">
            <h4 class="text-xs uppercase tracking-wide font-semibold text-base-content/50">Custos do item</h4>
            <% if editable %><%= structure_button("+ Custo", "add_cost:#{item.id}", editable: editable) %><% end %>
          </div>
          <% if item.costs.any? %>
            <table class="table table-xs mt-1 max-w-2xl">
              <thead>
                <tr class="text-[11px] uppercase text-base-content/50"><th>Descrição</th><th>Qtd.</th><th>Valor unit. (R$)</th><th class="text-right">Total</th><th></th></tr>
              </thead>
              <tbody>
                <% item.costs.each_with_index do |cost, index| %>
                  <% prefix = "project_pricing[pricing_items_attributes][#{item_form.index}][cost_items][#{index}]" %>
                  <tr data-pricing-preview-target="itemCost" data-item-id="<%= item.id %>">
                    <td class="min-w-56"><%= text_field_tag "#{prefix}[description]", cost["description"], id: nil, disabled: !editable, required: true, placeholder: "Ex.: ART, Inventário florestal (com logística)", class: "input input-xs w-full" %></td>
                    <td><%= number_field_tag "#{prefix}[quantity]", cost["quantity"], id: nil, step: "any", min: 0, disabled: !editable, class: "input input-xs w-16 text-right", data: { field: "quantity" } %></td>
                    <td><%= number_field_tag "#{prefix}[unit_value]", cost["unit_value"], id: nil, step: "any", min: 0, disabled: !editable, class: "input input-xs w-28 text-right", data: { field: "unit_value" } %></td>
                    <td class="text-right tabular-nums whitespace-nowrap" data-role="cost-total"><%= brl((cost["quantity"].to_d * cost["unit_value"].to_d).round(2)) %></td>
                    <td>
                      <% if editable %>
                        <%= structure_button("✕", "remove_cost:#{item.id}:#{index}", editable: editable, css: "btn btn-ghost btn-xs btn-square text-error") %>
                      <% end %>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          <% else %>
            <p class="text-xs text-base-content/50 mt-1">Nenhum (ex.: ART, subcontratado "com logística", carta de veterinário).</p>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
  <%# Empreendimentos %>
  <details id="empreendimentos" class="group/emp border-t border-base-300 px-6 py-4 bg-base-200/30 scroll-mt-40" <% if enterprises.any? %>open<% end %>>
    <summary class="flex flex-wrap items-center justify-between gap-3 cursor-pointer list-none">
      <div>
        <h3 class="text-sm font-semibold text-base-content flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/40 -rotate-90 group-open/emp:rotate-0 transition-transform"><path fill-rule="evenodd" d="M5.22 8.22a.75.75 0 0 1 1.06 0L10 11.94l3.72-3.72a.75.75 0 1 1 1.06 1.06l-4.25 4.25a.75.75 0 0 1-1.06 0L5.22 9.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" /></svg>
          Empreendimentos <span class="font-normal text-base-content/50">· <%= enterprises.empty? ? "um só" : enterprises.size %></span>
        </h3>
        <p class="text-xs text-base-content/60">
          <% if enterprises.empty? %>
            Um só. Cadastre quando a proposta cobrir mais de um — os itens sem empreendimento viram comuns e são rateados.
          <% else %>
            Itens sem empreendimento são comuns e rateados entre eles.
          <% end %>
        </p>
      </div>
      <% if editable %>
        <%= structure_button("+ Empreendimento", "add_enterprise", editable: editable) %>
      <% end %>
    </summary>
    <% if enterprises.any? %>
      <div class="flex flex-wrap items-end gap-3 mt-3">
        <%= form.fields_for :pricing_enterprises, enterprises do |enterprise_form| %>
          <div class="flex items-center gap-1">
            <%= enterprise_form.hidden_field :id %>
            <%= enterprise_form.text_field :name, disabled: !editable, required: true, class: "input input-sm w-52" %>
            <% if editable %>
              <%= structure_button("✕", "remove_enterprise:#{enterprise_form.object.id}", editable: editable, css: "btn btn-ghost btn-xs btn-square text-error",
                    confirm: "Remover o empreendimento #{enterprise_form.object.name}? Os itens dele viram comuns.") %>
            <% end %>
          </div>
        <% end %>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Rateio dos itens comuns</legend>
          <%= form.select :common_split, ProjectPricing::COMMON_SPLITS.invert, {}, disabled: !editable, class: "select select-sm w-72" %>
        </fieldset>
      </div>
      <% totals = pricing.enterprise_totals %>
      <dl class="flex flex-wrap gap-x-6 gap-y-1 mt-3 text-sm">
        <% totals.each do |name, value| %>
          <div class="flex items-baseline gap-1.5"><dt class="text-base-content/60"><%= name %></dt><dd class="tabular-nums font-medium"><%= brl(value) %></dd></div>
        <% end %>
      </dl>
      <p class="text-xs text-base-content/50 mt-1">Totais por empreendimento com BDI e impostos (é o que vai no quadro de preço), do último "Salvar e recalcular".</p>
    <% end %>
  </details>

</section>
