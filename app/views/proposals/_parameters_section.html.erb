<%# Parâmetros do motor de preço, em três grupos. locals: form (#pricing-form), pricing, editable %>

<section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3 px-6 pt-5 pb-4">
    <div>
      <h2 class="font-semibold text-base-content">Parâmetros</h2>
      <p class="text-sm text-base-content/60 mt-0.5">Margens, deslocamento e valores unitários da logística. As alterações entram no preço ao salvar.</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-px bg-base-300 border-y border-base-300">
    <div class="bg-base-100 p-5">
      <h3 class="text-sm font-semibold text-base-content">Margens</h3>
      <p class="text-xs text-base-content/50 mb-3">Multiplicadores sobre a equipe, os campos e os custos dos itens (1,20 = +20%).</p>
      <div class="grid grid-cols-2 lg:grid-cols-1 gap-3">
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">BDI</legend>
          <%= pricing_number_field form, :bdi, suffix: "×", step: "any", min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Impostos (ADM)</legend>
          <%= pricing_number_field form, :tax_multiplier, suffix: "×", step: "any", min: 0, disabled: !editable %>
        </fieldset>
      </div>
    </div>

    <div class="bg-base-100 p-5">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="text-sm font-semibold text-base-content">Deslocamento</h3>
          <p class="text-xs text-base-content/50 mb-3">Sede em Lauro de Freitas/BA até o projeto — base do combustível e dos dias de viagem dos campos.</p>
        </div>
        <% if editable %>
          <button type="submit" form="suggest-logistics-form" class="btn btn-ghost btn-xs text-primary" title="Recalcula a distância e o tempo de viagem a partir do KMZ/município">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd" /></svg>
            Recalcular
          </button>
        <% end %>
      </div>
      <% if pricing.long_distance? %>
        <div class="alert alert-warning alert-soft text-xs mb-3 py-2">
          <span><%= number_with_delimiter(pricing.distance_km, delimiter: ".", separator: ",") %> km (~<%= pricing.travel_hours %>h) sugere deslocamento aéreo — lance passagem e locação no destino nos custos do item.</span>
        </div>
      <% end %>
      <% destination = Logistics::DestinationResolver.resolve(pricing.proposal) %>
      <fieldset class="fieldset p-0 mb-3">
        <legend class="fieldset-legend pt-0">Local do projeto</legend>
        <%= form.text_field :municipality_query, disabled: !editable, autocomplete: "off", list: "municipios-proposta",
              placeholder: destination&.label || "Município/UF, ex.: Remanso/BA", class: "input input-sm w-full" %>
        <p class="label whitespace-normal <%= destination ? "" : "text-warning" %>">
          <% if pricing.ibge_municipality %>
            Informado pelo consultor. Apague pra voltar a usar o KMZ/ET.
          <% elsif destination %>
            Usando <%= destination.label %> (<%= destination.source %>). Preencha só pra corrigir.
          <% else %>
            Sem KMZ e sem município claro no ET — informe aqui (ou diga no chat) pra calcular distância e buscar hospedagem.
          <% end %>
        </p>
      </fieldset>
      <div class="grid grid-cols-2 gap-3">
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Distância (ida)</legend>
          <%= pricing_number_field form, :distance_km, suffix: "km", step: "any", min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Viagem (ida)</legend>
          <%= pricing_number_field form, :travel_hours, suffix: "h", step: "any", min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Rodagem em campo</legend>
          <%= pricing_number_field form, :daily_km, suffix: "km/dia", step: "any", min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Consumo</legend>
          <%= pricing_number_field form, :vehicle_consumption_km_per_liter, suffix: "km/l", step: "any", min: 0, disabled: !editable %>
        </fieldset>
      </div>
      <p class="text-xs text-base-content/50 mt-3">Viagem de <%= ProjectPricing::TRAVEL_DAY_HOURS %>h ou mais: campo novo já vem com 2 dias de deslocamento.</p>
    </div>

    <div class="bg-base-100 p-5">
      <h3 class="text-sm font-semibold text-base-content">Valores unitários</h3>
      <p class="text-xs text-base-content/50 mb-3">Usados em todos os campos desta proposta.</p>
      <div class="grid grid-cols-2 gap-3">
        <% [ [ :rental_per_day, "Carro", "diária" ], [ :rental_4x4_per_day, "4x4", "diária" ],
             [ :lodging_per_person_per_night, "Hospedagem padrão", "pessoa/noite, campo sem hospedagem escolhida" ], [ :meal_per_person_per_day, "Alimentação", "pessoa/dia" ],
             [ :fuel_price_per_liter, "Combustível", "litro" ], [ :toll_price, "Pedágio", "unidade" ],
             [ :wash_price, "Lavagem", "unidade" ], [ :uber_price, "Uber", "corrida" ],
             [ :mateiro_per_day, "Mateiro", "dia (com alimentação)" ], [ :epi_price, "EPI/ASO", "kit" ] ].each do |attribute, label, unit| %>
          <fieldset class="fieldset p-0">
            <legend class="fieldset-legend pt-0"><%= label %></legend>
            <%= pricing_number_field form, attribute, prefix: "R$", step: "any", min: 0, disabled: !editable %>
            <p class="label"><%= unit %></p>
          </fieldset>
        <% end %>
      </div>
    </div>
  </div>

  <dl class="flex flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4 text-sm">
    <div class="flex items-baseline gap-1.5 ml-auto">
      <dt class="text-base-content/60 font-medium">Logística dos campos (com BDI × impostos)</dt>
      <dd class="font-semibold text-base-content tabular-nums" data-pricing-preview-target="logistics"><%= brl(pricing.logistics_total) %></dd>
    </div>
  </dl>
</section>
