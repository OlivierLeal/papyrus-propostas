<%# Parâmetros do motor de preço, em três grupos. locals: form (#pricing-form), pricing, editable %>
<% breakdown = pricing.logistics_breakdown %>

<section class="bg-base-100 rounded-box border border-base-300 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3 px-6 pt-5 pb-4">
    <div>
      <h2 class="font-semibold text-base-content">Parâmetros</h2>
      <p class="text-sm text-base-content/60 mt-0.5">Margens e logística de campo. As alterações entram no preço ao salvar.</p>
    </div>
  </div>

  <div class="grid lg:grid-cols-3 gap-px bg-base-300 border-y border-base-300">
    <div class="bg-base-100 p-5">
      <h3 class="text-sm font-semibold text-base-content">Margens</h3>
      <p class="text-xs text-base-content/50 mb-3">Multiplicadores sobre o custo da equipe (1,20 = +20%).</p>
      <div class="grid grid-cols-2 lg:grid-cols-1 gap-3">
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">BDI</legend>
          <%= pricing_number_field form, :bdi, suffix: "×", step: 0.01, min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Impostos (ADM)</legend>
          <%= pricing_number_field form, :tax_multiplier, suffix: "×", step: 0.01, min: 0, disabled: !editable %>
        </fieldset>
      </div>
    </div>

    <div class="bg-base-100 p-5">
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="text-sm font-semibold text-base-content">Deslocamento</h3>
          <p class="text-xs text-base-content/50 mb-3">Sede em Lauro de Freitas/BA até o projeto.</p>
        </div>
        <% if editable %>
          <button type="submit" form="suggest-logistics-form" class="btn btn-ghost btn-xs text-primary" title="Recalcula distância, veículos e combustível a partir do KMZ/município">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5"><path fill-rule="evenodd" d="M15.312 11.424a5.5 5.5 0 0 1-9.201 2.466l-.312-.311h2.433a.75.75 0 0 0 0-1.5H3.989a.75.75 0 0 0-.75.75v4.242a.75.75 0 0 0 1.5 0v-2.43l.31.31a7 7 0 0 0 11.712-3.138.75.75 0 0 0-1.449-.39Zm1.23-3.723a.75.75 0 0 0 .219-.53V2.929a.75.75 0 0 0-1.5 0V5.36l-.31-.31A7 7 0 0 0 3.239 8.188a.75.75 0 1 0 1.448.389A5.5 5.5 0 0 1 13.89 6.11l.311.31h-2.432a.75.75 0 0 0 0 1.5h4.243a.75.75 0 0 0 .53-.219Z" clip-rule="evenodd" /></svg>
            Recalcular
          </button>
        <% end %>
      </div>
      <% if pricing.long_distance? %>
        <div class="alert alert-warning alert-soft text-xs mb-3 py-2">
          <span><%= number_with_delimiter(pricing.distance_km, delimiter: ".", separator: ",") %> km (~<%= pricing.travel_hours %>h) sugere deslocamento aéreo — lance passagem e locação no destino em Custos externos.</span>
        </div>
      <% end %>
      <div class="grid grid-cols-2 gap-3">
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Distância</legend>
          <%= pricing_number_field form, :distance_km, suffix: "km", step: 1, min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Viagem (ida)</legend>
          <%= pricing_number_field form, :travel_hours, suffix: "h", step: 0.1, min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Veículos</legend>
          <%= pricing_number_field form, :vehicles_count, step: 1, min: 1, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Consumo</legend>
          <%= pricing_number_field form, :vehicle_consumption_km_per_liter, suffix: "km/l", step: 0.1, min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Combustível</legend>
          <%= pricing_number_field form, :fuel_price_per_liter, prefix: "R$", step: 0.01, min: 0, disabled: !editable %>
          <p class="label">litro</p>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Combustível total</legend>
          <%= pricing_number_field form, :fuel_total, prefix: "R$", step: 0.01, min: 0, disabled: !editable %>
        </fieldset>
      </div>
    </div>

    <div class="bg-base-100 p-5">
      <h3 class="text-sm font-semibold text-base-content">Campo</h3>
      <p class="text-xs text-base-content/50 mb-3">
        <span data-pricing-preview-target="people"><%= pluralize(pricing.field_professionals_count, "pessoa", plural: "pessoas") %></span> em campo (quem tem diárias na equipe).
      </p>
      <div class="grid grid-cols-2 gap-3">
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Dias de campo</legend>
          <%= pricing_number_field form, :logistics_days, suffix: "dias", step: 1, min: 0, disabled: !editable %>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Aluguel</legend>
          <%= pricing_number_field form, :rental_per_day, prefix: "R$", step: 0.01, min: 0, disabled: !editable %>
          <p class="label">veículo/dia</p>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Hospedagem</legend>
          <%= pricing_number_field form, :lodging_per_person_per_night, prefix: "R$", step: 0.01, min: 0, disabled: !editable %>
          <p class="label">pessoa/noite</p>
        </fieldset>
        <fieldset class="fieldset p-0">
          <legend class="fieldset-legend pt-0">Alimentação</legend>
          <%= pricing_number_field form, :meal_per_person_per_day, prefix: "R$", step: 0.01, min: 0, disabled: !editable %>
          <p class="label">pessoa/dia</p>
        </fieldset>
      </div>
    </div>
  </div>

  <dl class="flex flex-wrap items-center gap-x-6 gap-y-2 px-6 py-4 text-sm">
    <% [ [ "Hospedagem", breakdown[:lodging], "lodging" ], [ "Alimentação", breakdown[:meals], "meals" ],
         [ "Aluguel", breakdown[:rental], "rental" ], [ "Combustível", breakdown[:fuel], "fuel" ] ].each do |label, value, target| %>
      <div class="flex items-baseline gap-1.5">
        <dt class="text-base-content/50"><%= label %></dt>
        <dd class="text-base-content tabular-nums" data-pricing-preview-target="<%= target %>"><%= brl(value) %></dd>
      </div>
    <% end %>
    <div class="flex items-baseline gap-1.5 ml-auto">
      <dt class="text-base-content/60 font-medium">Logística</dt>
      <dd class="font-semibold text-base-content tabular-nums" data-pricing-preview-target="logistics"><%= brl(pricing.logistics_total) %></dd>
    </div>
  </dl>
</section>
