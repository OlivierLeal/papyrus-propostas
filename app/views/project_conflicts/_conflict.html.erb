<%# Card de uma divergência entre documentos (ver ProjectConflict). O sistema mostra os dois lados
    com a origem de cada um; escolher o valor é decisão do consultor, nunca da IA. %>
<div id="<%= dom_id(conflict) %>" class="flex flex-col gap-3">
  <div class="flex items-start gap-2">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0 mt-0.5 text-warning">
      <path fill-rule="evenodd" d="M8.485 2.495c.673-1.167 2.357-1.167 3.03 0l6.28 10.875c.673 1.167-.17 2.625-1.516 2.625H3.72c-1.347 0-2.189-1.458-1.515-2.625L8.485 2.495ZM10 5a.75.75 0 0 1 .75.75v3.5a.75.75 0 0 1-1.5 0v-3.5A.75.75 0 0 1 10 5Zm0 9a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
    </svg>
    <div class="flex flex-col gap-1 min-w-0">
      <span class="text-xs uppercase tracking-wide opacity-70">Divergência entre documentos · <%= conflict.field_label %></span>
      <p class="text-sm"><%= conflict.summary %></p>
    </div>
  </div>

  <% findings = conflict.findings.includes(:source_blob).order(:id) %>
  <ul class="flex flex-col gap-2">
    <% findings.each do |finding| %>
      <li class="px-3 py-2 rounded-field bg-base-100/60 flex flex-col gap-1 min-w-0">
        <span class="text-sm font-semibold text-base-content"><%= finding.value %></span>
        <span class="text-xs opacity-60"><%= finding.origin_label %></span>
        <% if finding.excerpt.present? %>
          <span class="text-xs opacity-60 italic">“<%= finding.excerpt %>”</span>
        <% end %>
      </li>
    <% end %>
  </ul>

  <% if conflict.open? %>
    <div class="flex flex-col gap-2">
      <span class="text-xs opacity-70">Qual vale para esta proposta?</span>
      <div class="flex flex-wrap items-center gap-2">
        <% findings.each do |finding| %>
          <%= button_to finding.value.truncate(40),
                resolve_conversation_project_conflict_path(conflict.conversation, conflict),
                params: { value: finding.value },
                class: "btn btn-xs btn-primary" %>
        <% end %>
        <%= button_to "Não é divergência",
              dismiss_conversation_project_conflict_path(conflict.conversation, conflict),
              class: "btn btn-xs btn-ghost" %>
      </div>

      <%= form_with url: resolve_conversation_project_conflict_path(conflict.conversation, conflict),
            method: :post, class: "flex items-center gap-2" do |form| %>
        <%= form.text_field :value, placeholder: "ou escreva o valor correto",
              class: "input input-bordered input-xs flex-1" %>
        <%= form.submit "Registrar", class: "btn btn-xs btn-ghost" %>
      <% end %>
    </div>
  <% elsif conflict.resolved? %>
    <p class="text-xs text-success flex items-center gap-1">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 shrink-0">
        <path fill-rule="evenodd" d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm3.857-9.809a.75.75 0 0 0-1.214-.882l-3.483 4.79-1.88-1.88a.75.75 0 1 0-1.06 1.061l2.5 2.5a.75.75 0 0 0 1.137-.089l4-5.5Z" clip-rule="evenodd" />
      </svg>
      Decidido: <%= findings.first&.superseded_by&.value %>
    </p>
  <% else %>
    <p class="text-xs opacity-60">Marcado como “não é divergência”.</p>
  <% end %>
</div>
