<div class="p-8 max-w-md mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to users_path, class: "btn btn-ghost btn-sm btn-square", title: "Voltar" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <h1 class="font-display text-2xl font-bold text-base-content">Editar usuário</h1>
  </div>

  <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
    <%= form_with model: @user, url: user_path(@user), class: "flex flex-col gap-4" do |form| %>
      <% if @user.errors.any? %>
        <div class="alert alert-error alert-soft">
          <ul class="list-disc list-inside">
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <label class="form-control">
        <div class="label"><span class="label-text">Nome</span></div>
        <%= form.text_field :name, class: "input input-bordered w-full", required: true %>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">E-mail</span></div>
        <%= form.email_field :email_address, class: "input input-bordered w-full", required: true %>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Nova senha</span></div>
        <%= form.password_field :password, class: "input input-bordered w-full", autocomplete: "new-password" %>
        <div class="label"><span class="label-text-alt text-base-content/50">Deixe em branco para manter a senha atual</span></div>
      </label>

      <label class="form-control">
        <div class="label"><span class="label-text">Confirmar nova senha</span></div>
        <%= form.password_field :password_confirmation, class: "input input-bordered w-full", autocomplete: "new-password" %>
      </label>

      <div class="flex items-center gap-2 mt-2">
        <%= form.submit "Salvar", class: "btn btn-primary" %>
        <%= link_to "Cancelar", users_path, class: "btn btn-ghost" %>
      </div>
    <% end %>
  </div>
</div>
