<div class="p-8">
  <h1 class="font-display text-2xl font-bold text-base-content mb-1">Configurações</h1>
  <p class="text-sm text-base-content/60 mb-6">Parâmetros usados pelo motor de precificação e pela IA.</p>

  <%= render "settings/nav" %>

  <div class="flex items-center justify-between mb-4">
    <div>
      <h2 class="font-display text-xl font-bold text-base-content">Tipos de Estudo</h2>
      <p class="text-sm text-base-content/60"><%= pluralize(@study_types.size, "tipo de estudo cadastrado", plural: "tipos de estudo cadastrados") %></p>
    </div>
    <%= link_to new_settings_study_type_path, class: "btn btn-primary btn-sm gap-1.5" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
      </svg>
      Novo tipo de estudo
    <% end %>
  </div>

  <% if notice %>
    <div class="alert alert-success alert-soft mb-4"><%= notice %></div>
  <% end %>

  <% if alert %>
    <div class="alert alert-error alert-soft mb-4"><%= alert %></div>
  <% end %>

  <div class="bg-base-100 rounded-box border border-base-300 shadow-sm overflow-hidden">
    <table class="table">
      <thead>
        <tr class="bg-base-200/60 text-xs uppercase tracking-wide text-base-content/50">
          <th class="font-semibold">Nome</th>
          <th class="font-semibold">Código</th>
          <th class="font-semibold">Descrição</th>
          <th class="w-1"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-base-300">
        <% @study_types.each do |study_type| %>
          <tr class="hover:bg-base-200/40 transition-colors">
            <td class="font-medium text-base-content"><%= study_type.name %></td>
            <td><span class="badge badge-ghost"><%= study_type.code %></span></td>
            <td class="text-base-content/70 max-w-md truncate"><%= study_type.description %></td>
            <td>
              <div class="flex items-center gap-1 justify-end">
                <%= link_to edit_settings_study_type_path(study_type), class: "btn btn-ghost btn-sm btn-square", title: "Editar" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                    <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                  </svg>
                <% end %>
                <%= button_to settings_study_type_path(study_type), method: :delete,
                      class: "btn btn-ghost btn-sm btn-square text-error",
                      title: "Remover",
                      form: { data: { turbo_confirm: "Remover #{study_type.name}? Templates de estudo vinculados também serão removidos." } } do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path fill-rule="evenodd" d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
