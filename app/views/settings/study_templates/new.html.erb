<div class="p-8">
  <%= render "settings/form_header", section: "Templates de Estudo", back_path: settings_study_templates_path,
        title: "Novo template", subtitle: "Adicione um profissional/entregável ao menu de equipe de um tipo de estudo." %>

  <% if StudyType.none? || Professional.active.none? %>
    <div role="alert" class="alert alert-warning alert-soft">
      <span>
        É preciso ter pelo menos um <%= link_to "tipo de estudo", settings_study_types_path, class: "link" %>
        e um <%= link_to "profissional ativo", settings_professionals_path, class: "link" %> cadastrados antes de criar um template.
      </span>
    </div>
  <% else %>
    <%= render "form", study_template: @study_template %>
  <% end %>
</div>
