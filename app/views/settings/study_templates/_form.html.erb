<%= render "settings/form_errors", record: study_template %>

<%= form_with model: [ :settings, study_template ] do |form| %>
  <div class="bg-base-100 rounded-box border border-base-300 shadow-sm">
    <div class="divide-y divide-base-300">
      <section class="grid md:grid-cols-3 gap-6 p-6">
        <div>
          <h2 class="font-semibold text-base-content">Quem entrega o quê</h2>
          <p class="text-sm text-base-content/60 mt-1">Cada linha é uma opção do "menu" que a IA usa ao montar a equipe deste tipo de estudo.</p>
        </div>
        <div class="md:col-span-2 grid sm:grid-cols-2 gap-x-4">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Tipo de estudo</legend>
            <%= form.collection_select :study_type_id, StudyType.order(:name), :id, :name,
                  { prompt: "Selecione…" }, class: settings_field_class(study_template, :study_type, base: "select"), required: true %>
            <%= settings_field_error(study_template, :study_type) %>
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Profissional</legend>
            <%= form.collection_select :professional_id, Professional.active.order(:name), :id, :name,
                  { prompt: "Selecione…" }, class: settings_field_class(study_template, :professional, base: "select"), required: true %>
            <%= settings_field_error(study_template, :professional) %>
          </fieldset>

          <fieldset class="fieldset sm:col-span-2">
            <legend class="fieldset-legend">Entregável</legend>
            <%= form.text_field :deliverable_name, class: settings_field_class(study_template, :deliverable_name),
                  placeholder: "Ex.: Diagnóstico de Fauna — Avifauna", required: true %>
            <%= settings_field_error(study_template, :deliverable_name) || tag.p("O que este profissional entrega — sai como FUNÇÃO no quadro de equipe.", class: "label") %>
          </fieldset>
        </div>
      </section>

      <section class="grid md:grid-cols-3 gap-6 p-6">
        <div>
          <h2 class="font-semibold text-base-content">Esforço padrão</h2>
          <p class="text-sm text-base-content/60 mt-1">Ponto de partida quando a IA não sugere nada. O consultor ajusta por proposta na Tela de Precificação.</p>
        </div>
        <div class="md:col-span-2 grid sm:grid-cols-2 gap-x-4">
          <fieldset class="fieldset">
            <legend class="fieldset-legend">Horas-homem</legend>
            <label class="<%= settings_field_class(study_template, :man_hours_default) %>">
              <%= form.number_field :man_hours_default, step: "0.5", min: 0, required: true, class: "grow" %>
              <span class="text-xs text-base-content/40">HH</span>
            </label>
            <%= settings_field_error(study_template, :man_hours_default) || tag.p("Trabalho técnico/escritório.", class: "label") %>
          </fieldset>

          <fieldset class="fieldset">
            <legend class="fieldset-legend">Diárias de campo</legend>
            <label class="<%= settings_field_class(study_template, :field_days_default) %>">
              <%= form.number_field :field_days_default, step: "0.5", min: 0, required: true, class: "grow" %>
              <span class="text-xs text-base-content/40">dias</span>
            </label>
            <%= settings_field_error(study_template, :field_days_default) || tag.p("Dias em campo (vistoria, campanha).", class: "label") %>
          </fieldset>
        </div>
      </section>
    </div>

    <%= render "settings/form_actions", form: form, cancel_path: settings_study_templates_path,
          submit_label: study_template.new_record? ? "Cadastrar template" : "Salvar alterações" %>
  </div>
<% end %>
