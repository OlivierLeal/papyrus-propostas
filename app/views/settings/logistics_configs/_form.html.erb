<%= form_with model: [ :settings, logistics_config ], class: "flex flex-col gap-4" do |form| %>
  <% if logistics_config.errors.any? %>
    <div class="alert alert-error alert-soft">
      <ul class="list-disc list-inside">
        <% logistics_config.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <label class="form-control">
    <div class="label"><span class="label-text">Nome</span></div>
    <%= form.text_field :name, class: "input input-bordered w-full", placeholder: "Ex.: Padrão 2026", required: true %>
  </label>

  <div class="grid grid-cols-2 gap-4">
    <label class="form-control">
      <div class="label"><span class="label-text">Aluguel/dia (R$)</span></div>
      <%= form.number_field :rental_per_day, class: "input input-bordered w-full", step: "0.01", min: 0, required: true %>
    </label>

    <label class="form-control">
      <div class="label"><span class="label-text">Combustível/litro (R$)</span></div>
      <%= form.number_field :fuel_price_per_liter, class: "input input-bordered w-full", step: "0.01", min: 0, required: true %>
    </label>

    <label class="form-control">
      <div class="label"><span class="label-text">Hospedagem/dia (R$)</span></div>
      <%= form.number_field :lodging_per_day, class: "input input-bordered w-full", step: "0.01", min: 0, required: true %>
    </label>

    <label class="form-control">
      <div class="label"><span class="label-text">Alimentação/dia (R$)</span></div>
      <%= form.number_field :meal_per_day, class: "input input-bordered w-full", step: "0.01", min: 0, required: true %>
    </label>
  </div>

  <label class="label cursor-pointer justify-start gap-2">
    <%= form.check_box :active, class: "checkbox checkbox-sm" %>
    <span class="label-text">Ativo</span>
  </label>

  <div class="flex items-center gap-2 mt-2">
    <%= form.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", settings_logistics_configs_path, class: "btn btn-ghost" %>
  </div>
<% end %>
