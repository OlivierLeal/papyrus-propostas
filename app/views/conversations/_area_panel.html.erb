<%# Aba "Área": mapa do KMZ (clique amplia) e os números medidos pelo sistema. %>
<% result = conversation.geospatial_result %>
<div id="area_panel" class="flex flex-col gap-4">
  <% if result.nil? %>
    <div class="flex flex-col items-center text-center gap-2 py-8">
      <p class="font-semibold text-base-content">Sem área de estudo</p>
      <p class="text-xs text-base-content/60 max-w-64">Mande o KMZ, KML, shapefile (.zip) ou GeoJSON no chat para ver o mapa e medir a área.</p>
    </div>
  <% else %>
    <h2 class="font-display text-base font-semibold text-base-content"><%= result.area_label %></h2>

    <% if result.area_image.attached? %>
      <div class="relative group" data-controller="image-viewer">
        <button type="button" class="block w-full cursor-zoom-in" data-action="image-viewer#open" title="Ampliar mapa da área de estudo">
          <%= image_tag result.area_image_src, alt: "Mapa da área de estudo", class: "w-full rounded-field border border-base-300" %>
        </button>
        <span class="btn btn-sm btn-square absolute top-2 right-2 pointer-events-none bg-base-100/80 border-base-300 opacity-70 group-hover:opacity-100 transition-opacity" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
            <path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06L5.44 6.5H3.75a.75.75 0 0 0 0 1.5h3.5A.75.75 0 0 0 8 7.25v-3.5a.75.75 0 0 0-1.5 0v1.69L3.28 2.22ZM13.5 3.75a.75.75 0 0 0-1.5 0v3.5c0 .414.336.75.75.75h3.5a.75.75 0 0 0 0-1.5h-1.69l3.22-3.22a.75.75 0 0 0-1.06-1.06L13.5 5.44V3.75ZM3.75 12a.75.75 0 0 0 0 1.5h1.69l-3.22 3.22a.75.75 0 1 0 1.06 1.06l3.22-3.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5ZM12 12.75a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0 1.5h-1.69l3.22 3.22a.75.75 0 1 1-1.06 1.06l-3.22-3.22v1.69a.75.75 0 0 1-1.5 0v-3.5Z" clip-rule="evenodd" />
          </svg>
        </span>
        <dialog class="modal" data-image-viewer-target="dialog" data-action="click->image-viewer#closeOnBackdrop">
          <div class="modal-box max-w-[95vw] w-fit p-2">
            <%= image_tag result.area_image_src, alt: "Mapa da área de estudo", class: "max-h-[85vh] w-auto max-w-full rounded-field" %>
            <p class="text-sm text-base-content/70 px-2 pt-2"><%= result.summary_text %></p>
          </div>
          <form method="dialog" class="modal-backdrop">
            <button>Fechar</button>
          </form>
        </dialog>
      </div>
    <% end %>

    <% if result.area_ha.present? %>
      <div class="grid grid-cols-2 gap-2">
        <div class="rounded-field bg-base-200/60 px-3 py-2">
          <span class="block text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Área</span>
          <span class="font-display text-lg font-semibold text-base-content tabular-nums"><%= number_with_delimiter(result.area_ha.round(1), delimiter: ".", separator: ",") %> ha</span>
        </div>
        <div class="rounded-field bg-base-200/60 px-3 py-2">
          <span class="block text-[11px] font-semibold uppercase tracking-wider text-base-content/60">Perímetro</span>
          <span class="font-display text-lg font-semibold text-base-content tabular-nums"><%= number_with_delimiter(result.perimeter_km.to_f.round(2), delimiter: ".", separator: ",") %> km</span>
        </div>
      </div>
    <% end %>

    <% if (municipalities = result.municipalities_label).present? %>
      <div class="text-sm">
        <span class="block text-base-content/60">Municípios</span>
        <span class="font-semibold text-base-content"><%= municipalities %></span>
      </div>
    <% end %>
  <% end %>
</div>
