<div class="p-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="font-display text-2xl font-bold text-base-content leading-tight">Propostas</h1>
      <p class="text-sm text-base-content/60"><%= pluralize(@conversations.size, "proposta", plural: "propostas") %></p>
    </div>

    <%= link_to new_conversation_path, class: "btn btn-primary btn-sm gap-1.5" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path d="M10.75 4.75a.75.75 0 0 0-1.5 0v4.5h-4.5a.75.75 0 0 0 0 1.5h4.5v4.5a.75.75 0 0 0 1.5 0v-4.5h4.5a.75.75 0 0 0 0-1.5h-4.5v-4.5Z" />
      </svg>
      Nova Proposta
    <% end %>
  </div>

  <%= form_with url: conversations_path, method: :get, class: "mb-6" do |form| %>
    <label class="input input-bordered flex items-center gap-2 w-full max-w-md">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/40 shrink-0">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
      </svg>
      <%= form.text_field :q, value: @query, placeholder: "Buscar por cliente, código (PTC26098) ou ano...",
            class: "grow", autocomplete: "off" %>
    </label>
  <% end %>

  <% if @conversations.empty? %>
    <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-8 text-center text-base-content/60">
      <% if @query.present? %>
        Nenhuma proposta encontrada para "<%= @query %>". <%= link_to "Limpar busca", conversations_path, class: "link link-primary" %>.
      <% else %>
        Nenhuma proposta ainda. <%= link_to "Crie a primeira", new_conversation_path, class: "link link-primary" %>.
      <% end %>
    </div>
  <% else %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% @conversations.each do |conversation| %>
        <%= link_to conversation_path(conversation),
              class: "card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow" do %>
          <div class="card-body gap-3">
            <div class="flex items-start justify-between gap-2">
              <h3 class="font-semibold text-base-content leading-tight">
                <%= conversation.client_name %>
                <% if conversation.proposal.present? %>
                  <span class="text-base-content/50 font-normal text-sm"><%= conversation.proposal.docx_numero_proposta %></span>
                <% end %>
              </h3>
              <span class="badge badge-soft shrink-0 <%= conversation.status == "setup" ? "badge-warning" : "badge-success" %>">
                <%= conversation.status_label %>
              </span>
            </div>

            <span class="badge badge-ghost w-fit"><%= conversation.study_type&.name || "Tipo de estudo pendente" %></span>

            <div class="text-xs text-base-content/40">
              <%= conversation.user.name %> · <%= conversation.created_at.strftime("%d/%m/%Y") %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
