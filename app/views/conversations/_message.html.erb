<% is_user = message.role == "user" %>
<% parsed_content = message.content.present? ? (JSON.parse(message.content) rescue nil) : nil %>
<% animate = local_assigns.fetch(:animate, false) %>
<div class="flex items-end gap-2 min-w-0 <%= is_user ? "self-end flex-row-reverse max-w-[50%]" : "self-start max-w-[75%]" %>">
  <div class="avatar <%= is_user ? "" : "avatar-placeholder" %> shrink-0">
    <div class="w-9 rounded-full <%= is_user ? "" : "bg-neutral text-neutral-content" %>">
      <% if is_user %>
        <%= image_tag "logo_icon.svg", alt: "Papyrus" %>
      <% else %>
        <span class="text-xs">IA</span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-col gap-1 min-w-0 <%= is_user ? "items-end" : "items-start" %>">
    <span class="text-xs text-base-content/40 px-1"><%= is_user ? "Você" : "IA" %></span>

    <div class="w-fit max-w-full rounded-box px-4 py-3 text-sm <%= is_user ? "bg-primary text-primary-content" : "bg-base-200 text-base-content" %>">
      <% if parsed_content.is_a?(Hash) %>
        <dl class="flex flex-col gap-2">
          <% parsed_content.each do |key, value| %>
            <div>
              <dt class="font-semibold text-xs uppercase tracking-wide opacity-70"><%= key.to_s.tr("_", " ") %></dt>
              <dd>
                <% if value.is_a?(Array) %>
                  <%= value.any? ? value.join(", ") : "—" %>
                <% else %>
                  <%= value.presence || "—" %>
                <% end %>
              </dd>
            </div>
          <% end %>
        </dl>
      <% elsif message.content.present? %>
        <%= tag.div render_markdown(message.content), class: "markdown-content", data: (animate ? { controller: "typewriter" } : {}) %>
      <% else %>
        <span class="italic opacity-60">(sem conteúdo)</span>
      <% end %>
    </div>
  </div>
</div>
