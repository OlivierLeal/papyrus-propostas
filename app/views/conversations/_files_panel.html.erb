<%# Aba "Arquivos": o que a IA gerou (revisões da proposta, planilhas preenchidas) e, à parte, o que
    foi enviado — planilhas do cliente com a situação do preenchimento. %>
<% uploaded = conversation.messages.includes(attachments_attachments: :blob).where(internal: false).order(:created_at).flat_map(&:attachments) %>
<div id="files_panel" class="flex flex-col gap-5">
  <%= render "documents/generated", conversation: conversation %>

  <section class="flex flex-col gap-2">
    <h2 class="font-display text-base font-semibold text-base-content">Enviados</h2>
    <% if uploaded.any? %>
      <ul class="flex flex-col gap-1.5">
        <% uploaded.each do |attachment| %>
          <%= render "conversations/file_row", file: attachment, kind: document_kind_label(attachment), highlight: false %>
          <% if attachment.record.role == "user" && SpreadsheetFill.spreadsheet?(attachment.filename) %>
            <%= render "spreadsheet_fills/status", conversation: conversation, attachment: attachment %>
          <% end %>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-base-content/60">Nenhum arquivo enviado.</p>
    <% end %>
  </section>
</div>
