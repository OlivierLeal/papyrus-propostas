<%# Ocupa exatamente a altura que sobra embaixo da barra do topo (shared/_layout: h-screen com
    pt-[8vh]) — o chat estica até o fim da tela em qualquer monitor, sem altura calculada fixa. %>
<div class="p-2 mx-auto flex flex-col gap-3 lg:h-[92vh]">
  <%= render "conversations/header", conversation: @conversation %>

  <%= turbo_stream_from @conversation %>

  <% if @conversation.status.in?(%w[reviewing pricing completed]) %>
    <%# Chat largo à esquerda; contexto em abas à direita (no celular, o painel vem antes do chat). %>
    <%# Painel recolhível (side_panel_controller.js): o cookie faz o servidor já desenhar recolhido, sem
        piscar no refresh por morph. Recolhido, vira uma barra de ícones de 3,5rem. %>
    <div class="group/panel grid grid-cols-1 gap-3 lg:flex-1 lg:min-h-0 lg:grid-cols-[minmax(0,1fr)_23rem] lg:data-[collapsed=true]:grid-cols-[minmax(0,1fr)_3.5rem]"
         data-controller="side-panel" data-collapsed="<%= cookies[:side_panel_collapsed] == "1" %>">
      <div class="relative bg-base-100 rounded-box border border-base-300 shadow-sm flex flex-col h-[80vh] lg:h-full lg:min-h-0 min-w-0"
           data-controller="chat-scroll file-drop"
           data-action="dragover->file-drop#over dragleave->file-drop#leave drop->file-drop#drop">
        <div data-file-drop-target="overlay" hidden
             class="absolute inset-2 z-20 rounded-box border-2 border-dashed border-primary bg-base-100/90 flex items-center justify-center pointer-events-none">
          <span class="text-primary font-semibold">Solte o arquivo aqui para anexar</span>
        </div>

        <h2 class="sr-only">Conversa</h2>
        <% visible_messages = @conversation.messages.includes(:user, attachments_attachments: :blob).where(internal: false).order(:created_at) %>
        <div id="messages" class="flex-1 overflow-y-auto px-4 py-5 sm:px-6 flex flex-col gap-4" data-chat-scroll-target="messages">
          <% visible_messages.each do |message| %>
            <%= render "message", message: message %>
          <% end %>
          <% if @conversation.ai_responding? %>
            <%= render "typing_indicator" %>
          <% end %>
        </div>

        <%= render "message_composer", conversation: @conversation %>
      </div>

      <div class="order-first lg:order-none min-h-0">
        <%= render "conversations/side_panel", conversation: @conversation %>
      </div>
    </div>
  <% else %>
    <%= render "processing_status", conversation: @conversation %>
  <% end %>
</div>
