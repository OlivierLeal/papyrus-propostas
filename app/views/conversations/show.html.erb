<div class="p-2 mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to conversations_path, class: "btn btn-ghost btn-sm btn-square", title: "Voltar" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <div>
      <h1 class="font-display text-2xl font-bold text-base-content leading-tight">
        <%= @conversation.client_name %>
        <% if @conversation.proposal.present? %>
          <span class="text-base-content/50 font-normal"><%= @conversation.proposal.docx_numero_proposta %></span>
        <% end %>
      </h1>
      <p class="text-sm text-base-content/60"><%= @conversation.study_type&.name || "Tipo de estudo: aguardando identificação da IA" %></p>
    </div>
    <span class="badge badge-soft ml-auto <%= @conversation.status == "setup" ? "badge-warning" : "badge-success" %>">
      <%= @conversation.status_label %>
    </span>
  </div>

  <%= turbo_stream_from @conversation %>

  <% if @conversation.status.in?(%w[reviewing pricing completed]) %>
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 lg:h-[80vh]">
      <div class="lg:col-span-1 flex flex-col gap-4 lg:overflow-y-auto lg:min-h-0 lg:pr-1">
        <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
          <h2 class="font-semibold text-base-content mb-4">Tipo de estudo</h2>

          <%= form_with model: @conversation, url: conversation_path(@conversation), method: :patch, class: "flex items-center gap-2" do |form| %>
            <%= form.collection_select :study_type_id, StudyType.order(:name), :id, :name, {}, class: "select select-bordered select-sm flex-1" %>
            <%= form.submit "Salvar", class: "btn btn-ghost btn-sm" %>
          <% end %>
          <p class="text-xs text-base-content/50 mt-2">Identificado pela IA a partir da TR — troque aqui se achar que ela errou.</p>
        </div>

        <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
          <h2 class="font-semibold text-base-content mb-4">Documentos</h2>

          <ul class="flex flex-col gap-2">
            <% @conversation.messages.includes([:attachments_attachments]).where(internal: false).order(:created_at).flat_map(&:attachments).each do |attachment| %>
              <li class="flex items-center gap-2 px-3 py-2 rounded-field bg-base-200/50 min-w-0">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/50 shrink-0">
                  <path fill-rule="evenodd" d="M4 4a2 2 0 0 1 2-2h4.586A2 2 0 0 1 12 2.586L15.414 6A2 2 0 0 1 16 7.414V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Z" clip-rule="evenodd" />
                </svg>
                <span class="truncate text-sm text-base-content flex-1"><%= attachment.filename %></span>
                <%= link_to rails_blob_path(attachment, disposition: "attachment"),
                      class: "btn btn-ghost btn-xs btn-square text-primary shrink-0", title: "Baixar" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
                    <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v6.638l1.96-2.158a.75.75 0 1 1 1.08 1.04l-3.25 3.5a.75.75 0 0 1-1.08 0l-3.25-3.5a.75.75 0 1 1 1.08-1.04l1.96 2.158V3.75A.75.75 0 0 1 10 3ZM3.75 13.5a.75.75 0 0 0-1.5 0v3.75a.75.75 0 0 0 .75.75h13.5a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-1.5 0v3H3.75v-3Z" clip-rule="evenodd" />
                  </svg>
                <% end %>
              </li>
            <% end %>
          </ul>

          <% generated_documents = @conversation.proposal&.generated_documents&.to_a || [] %>
          <% if generated_documents.any? %>
            <div class="divider text-xs text-base-content/50 my-3">Gerados pela IA</div>

            <% sorted_documents = generated_documents.sort_by { |d| [ -(d.blob.metadata["version"] || 0), -d.created_at.to_i ] } %>
            <ul class="flex flex-col gap-2">
              <% sorted_documents.each do |document| %>
                <li class="flex items-center gap-2 px-3 py-2 rounded-field bg-primary/5 min-w-0">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-primary shrink-0">
                    <path fill-rule="evenodd" d="M4 4a2 2 0 0 1 2-2h4.586A2 2 0 0 1 12 2.586L15.414 6A2 2 0 0 1 16 7.414V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Z" clip-rule="evenodd" />
                  </svg>
                  <span class="truncate text-sm text-base-content flex-1"><%= document.filename %></span>
                  <% if document.blob.metadata["version"] %>
                    <span class="badge badge-ghost badge-xs shrink-0">v<%= document.blob.metadata["version"] %></span>
                  <% end %>
                  <%= link_to rails_blob_path(document, disposition: "attachment"),
                        class: "btn btn-ghost btn-xs btn-square text-primary shrink-0", title: "Baixar" do %>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-3.5">
                      <path fill-rule="evenodd" d="M10 3a.75.75 0 0 1 .75.75v6.638l1.96-2.158a.75.75 0 1 1 1.08 1.04l-3.25 3.5a.75.75 0 0 1-1.08 0l-3.25-3.5a.75.75 0 1 1 1.08-1.04l1.96 2.158V3.75A.75.75 0 0 1 10 3ZM3.75 13.5a.75.75 0 0 0-1.5 0v3.75a.75.75 0 0 0 .75.75h13.5a.75.75 0 0 0 .75-.75V13.5a.75.75 0 0 0-1.5 0v3H3.75v-3Z" clip-rule="evenodd" />
                    </svg>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <% if @conversation.geospatial_result.present? %>
          <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
            <h2 class="font-semibold text-base-content mb-4">Área do KMZ</h2>

            <% if @conversation.geospatial_result.area_image.attached? %>
              <div class="relative group mb-3" data-controller="image-viewer">
                <button type="button" class="block w-full cursor-zoom-in" data-action="image-viewer#open"
                        title="Ampliar mapa da área de estudo">
                  <%= image_tag @conversation.geospatial_result.area_image, alt: "Mapa da área de estudo",
                        class: "w-full rounded-field border border-base-300" %>
                </button>

                <span class="btn btn-sm btn-square absolute top-2 right-2 pointer-events-none
                             bg-base-100/80 border-base-300 opacity-70 group-hover:opacity-100 transition-opacity"
                      aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
                    <path fill-rule="evenodd" d="M3.28 2.22a.75.75 0 0 0-1.06 1.06L5.44 6.5H3.75a.75.75 0 0 0 0 1.5h3.5A.75.75 0 0 0 8 7.25v-3.5a.75.75 0 0 0-1.5 0v1.69L3.28 2.22ZM13.5 3.75a.75.75 0 0 0-1.5 0v3.5c0 .414.336.75.75.75h3.5a.75.75 0 0 0 0-1.5h-1.69l3.22-3.22a.75.75 0 0 0-1.06-1.06L13.5 5.44V3.75ZM3.75 12a.75.75 0 0 0 0 1.5h1.69l-3.22 3.22a.75.75 0 1 0 1.06 1.06l3.22-3.22v1.69a.75.75 0 0 0 1.5 0v-3.5a.75.75 0 0 0-.75-.75h-3.5ZM12 12.75a.75.75 0 0 1 .75-.75h3.5a.75.75 0 0 1 0 1.5h-1.69l3.22 3.22a.75.75 0 1 1-1.06 1.06l-3.22-3.22v1.69a.75.75 0 0 1-1.5 0v-3.5Z" clip-rule="evenodd" />
                  </svg>
                </span>

                <dialog class="modal" data-image-viewer-target="dialog" data-action="click->image-viewer#closeOnBackdrop">
                  <div class="modal-box max-w-[95vw] w-fit p-2">
                    <%= image_tag @conversation.geospatial_result.area_image, alt: "Mapa da área de estudo",
                          class: "max-h-[85vh] w-auto max-w-full rounded-field" %>
                    <p class="text-sm text-base-content/70 px-2 pt-2"><%= @conversation.geospatial_result.summary_text %></p>
                  </div>

                  <form method="dialog" class="modal-backdrop">
                    <button>Fechar</button>
                  </form>
                </dialog>
              </div>
            <% end %>

            <p class="text-sm text-base-content/70"><%= @conversation.geospatial_result.summary_text %></p>
          </div>
        <% end %>

        <% if @conversation.status == "reviewing" && @conversation.study_type.present? %>
          <%= button_to "Avançar para Precificação", conversation_proposal_path(@conversation), class: "btn btn-primary w-full" %>
        <% elsif @conversation.status == "reviewing" %>
          <button class="btn btn-primary w-full" disabled>Avançar para Precificação</button>
        <% elsif @conversation.status.in?(%w[pricing completed]) %>
          <%= link_to "Ver Precificação", conversation_proposal_path(@conversation), class: "btn btn-primary w-full" %>
        <% end %>
      </div>

      <div class="lg:col-span-3 bg-base-100 rounded-box border border-base-300 shadow-sm flex flex-col h-[80vh] lg:h-full lg:min-h-0"
           data-controller="chat-scroll">
        <h2 class="font-semibold text-base-content p-6 pb-4 shrink-0 border-b border-base-300">Conversa</h2>

        <% visible_messages = @conversation.messages.where(internal: false).order(:created_at) %>
        <div id="messages" class="flex-1 overflow-y-auto p-6 flex flex-col gap-4" data-chat-scroll-target="messages">
          <% visible_messages.each do |message| %>
            <%= render "message", message: message %>
          <% end %>
          <% if visible_messages.last&.role == "user" %>
            <%= render "typing_indicator" %>
          <% end %>
        </div>

        <%= render "message_composer", conversation: @conversation %>
      </div>
    </div>
  <% else %>
    <%= render "processing_status", conversation: @conversation %>
  <% end %>
</div>
