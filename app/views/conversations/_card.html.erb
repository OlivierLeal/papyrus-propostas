<%= link_to conversation_path(conversation),
      class: "card bg-base-100 border border-base-300 shadow-sm hover:shadow-md transition-shadow" do %>
  <div class="card-body gap-3">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-base-content leading-tight">
        <%= conversation.client_name %>
        <% if conversation.proposal.present? %>
          <span class="text-base-content/50 font-normal text-sm"><%= conversation.proposal.docx_numero_proposta %></span>
        <% end %>
      </h3>
      <%= conversation_status_badge(conversation, extra_class: "shrink-0") %>
    </div>

    <span class="badge badge-ghost w-fit"><%= conversation.study_types_label %></span>

    <div class="flex items-center justify-between gap-2 text-xs text-base-content/40">
      <span><%= conversation.user.name %> · <%= conversation.created_at.strftime("%d/%m/%Y") %></span>
      <% if (cost = conversation.ai_cost_usd) %>
        <span title="Custo estimado de IA nesta conversa">
          ≈ <%= number_to_currency(cost, unit: "US$", separator: ",", delimiter: ".") %>
        </span>
      <% end %>
    </div>
  </div>
<% end %>
