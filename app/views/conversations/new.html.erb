<div class="p-8 mx-auto">
  <div class="flex items-center gap-3 mb-6">
    <%= link_to conversations_path, class: "btn btn-ghost btn-sm btn-square", title: "Voltar" do %>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
        <path fill-rule="evenodd" d="M17 10a.75.75 0 0 1-.75.75H5.612l4.158 3.96a.75.75 0 1 1-1.04 1.08l-5.5-5.25a.75.75 0 0 1 0-1.08l5.5-5.25a.75.75 0 1 1 1.04 1.08L5.612 9.25H16.25A.75.75 0 0 1 17 10Z" clip-rule="evenodd" />
      </svg>
    <% end %>
    <div>
      <h1 class="font-display text-2xl font-bold text-base-content leading-tight">Nova Proposta</h1>
      <p class="text-sm text-base-content/60">Informe os dados básicos e suba os arquivos que já tiver — o resto pode vir depois, pelo chat.</p>
    </div>
  </div>

  <%= form_with model: @conversation, url: conversations_path, class: "flex flex-col gap-4", multipart: true do |form| %>
    <% if @conversation.errors.any? %>
      <div class="alert alert-error alert-soft">
        <ul class="list-disc list-inside">
          <% @conversation.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
      <h2 class="font-semibold text-base-content mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/50">
          <path fill-rule="evenodd" d="M18 10a8 8 0 1 1-16 0 8 8 0 0 1 16 0Zm-7-4a1 1 0 1 1-2 0 1 1 0 0 1 2 0ZM9.75 9a.75.75 0 0 0 0 1.5h.25v3.25a.75.75 0 0 0 1.5 0v-4A.75.75 0 0 0 10.75 9h-1Z" clip-rule="evenodd" />
        </svg>
        Informações básicas
      </h2>

      <label class="form-control">
        <div class="label"><span class="label-text">Nome do cliente</span></div>
        <%= form.text_field :client_name, class: "input input-bordered w-full", placeholder: "Ex.: Serra Verde Energias Renováveis", required: true %>
      </label>
      <p class="text-xs text-base-content/50 mt-2">O tipo de estudo não é escolhido aqui — a IA identifica lendo a TR e você confirma na tela de revisão.</p>
    </div>

    <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
      <h2 class="font-semibold text-base-content mb-1 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/50">
          <path fill-rule="evenodd" d="M4 4a2 2 0 0 1 2-2h4.586A2 2 0 0 1 12 2.586L15.414 6A2 2 0 0 1 16 7.414V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Z" clip-rule="evenodd" />
        </svg>
        Arquivos
      </h2>
      <p class="text-xs text-base-content/50 mb-4">Todos opcionais aqui — dá pra enviar depois, direto no chat.</p>

      <div class="flex flex-col gap-3">
        <label class="flex items-center gap-3 p-3 rounded-field border border-base-300 hover:border-primary/40 transition-colors cursor-pointer">
          <div class="size-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path fill-rule="evenodd" d="M4.5 2A1.5 1.5 0 0 0 3 3.5v13A1.5 1.5 0 0 0 4.5 18h11a1.5 1.5 0 0 0 1.5-1.5V7.621a1.5 1.5 0 0 0-.44-1.06l-4.12-4.122A1.5 1.5 0 0 0 11.378 2H4.5Zm4.75 6.5a.75.75 0 0 1 .75.75v2.69l.72-.72a.75.75 0 1 1 1.06 1.06l-2 2a.75.75 0 0 1-1.06 0l-2-2a.75.75 0 0 1 1.06-1.06l.72.72V9.25a.75.75 0 0 1 .75-.75Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-base-content">Termo de Referência (TR)</p>
            <p class="text-xs text-base-content/50">PDF ou DOCX — pode escolher vários (ex.: TR + anexos)</p>
          </div>
          <input type="file" name="tr[]" multiple accept=".pdf,.doc,.docx" class="file-input file-input-sm file-input-bordered max-w-[10rem]">
        </label>

        <label class="flex items-center gap-3 p-3 rounded-field border border-base-300 hover:border-primary/40 transition-colors cursor-pointer">
          <div class="size-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path fill-rule="evenodd" d="M9.69 18.933 5.5 15.75l-2.79-2.09a1.5 1.5 0 0 1 0-2.4l2.79-2.09 4.19-3.183a1.5 1.5 0 0 1 1.82 0l4.19 3.183 2.79 2.09a1.5 1.5 0 0 1 0 2.4l-2.79 2.09-4.19 3.183a1.5 1.5 0 0 1-1.82 0Z" clip-rule="evenodd" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-base-content">Área de estudo (KMZ)</p>
            <p class="text-xs text-base-content/50">.kmz ou .kml</p>
          </div>
          <input type="file" name="kmz" accept=".kmz,.kml" class="file-input file-input-sm file-input-bordered max-w-[10rem]">
        </label>

        <label class="flex items-center gap-3 p-3 rounded-field border border-base-300 hover:border-primary/40 transition-colors cursor-pointer">
          <div class="size-9 rounded-full bg-primary/10 text-primary flex items-center justify-center shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4">
              <path d="M4 4a2 2 0 0 1 2-2h4.586A2 2 0 0 1 12 2.586L15.414 6A2 2 0 0 1 16 7.414V16a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4Zm2.75 6a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Zm0 3a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5h-6.5Z" />
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-medium text-base-content">Documentos complementares</p>
            <p class="text-xs text-base-content/50">Propostas anteriores, normas, condicionantes... pode escolher vários</p>
          </div>
          <input type="file" name="complementary_documents[]" multiple
                 accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                 class="file-input file-input-sm file-input-bordered max-w-[10rem]">
        </label>
      </div>
    </div>

    <div class="bg-base-100 rounded-box border border-base-300 shadow-sm p-6">
      <h2 class="font-semibold text-base-content mb-1 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-4 text-base-content/50">
          <path fill-rule="evenodd" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v11.75A2.75 2.75 0 0 0 16.75 18h-12A2.75 2.75 0 0 1 2 15.25V3.5Zm3.75 7a.75.75 0 0 0 0 1.5h4.5a.75.75 0 0 0 0-1.5h-4.5ZM5 6.75A.75.75 0 0 1 5.75 6h4.5a.75.75 0 0 1 0 1.5h-4.5A.75.75 0 0 1 5 6.75Z" clip-rule="evenodd" />
        </svg>
        Observações
      </h2>
      <p class="text-xs text-base-content/50 mb-4">Algo que o consultor de IA deveria já saber antes de começar a análise? Fica registrado como a primeira mensagem da conversa.</p>

      <textarea name="notes" rows="3" class="textarea textarea-bordered w-full"
                placeholder="Ex.: cliente pediu urgência, já tivemos contato anterior com esse órgão, considerar apenas a fase de LP por enquanto..."></textarea>
    </div>

    <div class="flex items-center gap-2 mt-2">
      <%= form.submit "Enviar arquivos", class: "btn btn-primary" %>
      <%= link_to "Cancelar", conversations_path, class: "btn btn-ghost" %>
    </div>
  <% end %>
</div>
